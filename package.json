{
  "name": "homesolar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "tsx scripts/db-check.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:check:test": "tsx scripts/db-check-test.ts",
    "db:seed:test": "tsx scripts/seed-test.ts",
    "db:drop:test": "tsx scripts/db-drop-test.ts",
    "test:integrity": "tsx scripts/integrity-check.ts",
    "seo:check": "tsx scripts/seo-check.ts",
    "seo:check:test": "SEO_CHECK_TEST=1 tsx scripts/seo-check.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "assets": "node scripts/extract-assets.mjs && node scripts/fetch-stock.mjs",
    "qa": "npm run typecheck && npm run lint && npm run build && npm run db:drop:test && npm run db:seed:test && npm run test:integrity && npm run seo:check:test && npm run test && npm run test:e2e && npm run test:a11y"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.72.0",
    "mongoose": "^9.12.1",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "schema-dts": "^1.1.5",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
