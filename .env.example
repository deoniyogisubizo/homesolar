# Google OAuth (optional). Without these, "Continue with Google" is disabled.
# Create a Web application client in Google Cloud Console > APIs & Services >
# Credentials, then add the exact redirect URI below to "Authorized redirect URIs".
#   Local:  http://localhost:3000/api/auth/callback/google
#   Prod:   https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
